
-- gh:karnull/switchboard.nvim

return {
    cd_root =  true,

    commands = {
        run    = 'devcontainer exec cargo run',
        build  = 'devcontainer exec cargo build --release',
        test   = 'devcontainer exec cargo test',
    },

    binds = {
        label  = 'O/*<Esc>76A-<Esc>A*/<CR>',
        openbr = 'A {<CR>}<Esc>O',
    }
}

